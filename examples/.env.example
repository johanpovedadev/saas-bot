# WhatsApp Bot Configuration
WHATSAPP_SESSION_NAME=mundo-helados-bot
WHATSAPP_QR_TIMEOUT=60000

# Google Sheets API
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_APPLICATION_CREDENTIALS=./path/to/service-account.json

# Google Sheets Ranges
SHEETS_RANGE_PRODUCTS=Productos!A:F
SHEETS_RANGE_SABORES=Sabores!A:D
SHEETS_RANGE_TOPPINGS=Toppings!A:D
SHEETS_RANGE_ORDERS=Pedidos!A:Z

# AI Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=1000

# Application Settings
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
LOG_PRETTY_PRINT=true

# Admin Configuration
ADMIN_PHONE_NUMBERS=+573001234567,+573009876543

# Feature Flags
ENABLE_FUZZY_SEARCH=true
ENABLE_AI_PARSER=true
ENABLE_FRUSTRATION_DETECTION=true
ENABLE_PROGRESS_INDICATORS=true

# Cache Settings
CACHE_PRODUCTS_TTL=300000
CACHE_SABORES_TOPPINGS_TTL=600000

# Session Settings
SESSION_TIMEOUT=1800000
SESSION_GC_INTERVAL=300000

# Performance Settings
MAX_CONCURRENT_SESSIONS=100
MESSAGE_RATE_LIMIT=10
