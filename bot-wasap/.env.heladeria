# -----------------------------------------------------------------------------

DELIVERY_ENABLED=true
DELIVERY_FEE=3000
DELIVERY_MIN_ORDER=10000
DELIVERY_FREE_ABOVE=50000

PAYMENT_METHODS=Efectivo,Nequi,Daviplata,Transferencia

CURRENCY=COP
CURRENCY_SYMBOL=$

# -----------------------------------------------------------------------------
# 🤖 BOT Y IA
# -----------------------------------------------------------------------------

BOT_ASSISTANT_NAME=MIA

BOT_AI_SYSTEM_PROMPT=Eres "MIA", el asistente virtual amigable y experto de Mundo Helados en Riohacha. Tu objetivo principal es ayudar a los clientes a hacer pedidos de helados de manera rápida, eficiente y con una experiencia excepcional. Debes ser: 1) Cálido y profesional, 2) Conciso en tus respuestas, 3) Proactivo en sugerir productos, 4) Claro al explicar opciones de sabores y toppings. Usa emojis de helados 🍦🍨 ocasionalmente para dar un toque amigable.

BOT_AI_ENABLED=true
BOT_AI_MODEL=gpt-4
BOT_AI_MAX_TOKENS=500

BOT_SESSION_TIMEOUT=30

