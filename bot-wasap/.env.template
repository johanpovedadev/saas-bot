# =============================================================================
# 🤖 BOT WHATSAPP GENÉRICO - CONFIGURACIÓN MULTI-NEGOCIO
# =============================================================================
# Este archivo contiene TODAS las variables necesarias para configurar el bot
# para cualquier tipo de negocio (heladería, pizzería, panadería, etc.)
#
# INSTRUCCIONES:
# 1. Copia este archivo a .env (cp .env.template .env)
# 2. Rellena TODOS los valores según tu negocio
# 3. Reinicia el bot para aplicar cambios
#
# EJEMPLOS DISPONIBLES:
# - .env.heladeria   → Configuración para Mundo Helados (referencia)
# - .env.pizzeria    → Configuración para pizzería
# - .env.panaderia   → Configuración para panadería
# =============================================================================

# -----------------------------------------------------------------------------
# 📌 INFORMACIÓN DEL NEGOCIO
# -----------------------------------------------------------------------------

# Tipo de negocio (define plantillas y comportamiento general)
# Opciones: heladeria | pizzeria | panaderia | restaurante | cafeteria | pasteleria
BUSINESS_TYPE=heladeria

# Nombre completo del negocio
BUSINESS_NAME=Mundo Helados Riohacha

# Nombre corto (para mensajes)
BUSINESS_SHORT_NAME=Mundo Helados

# ID único del negocio (para logs y tracking)
BUSINESS_ID=MUNDO_HELADOS_RIOHACHA

# Ciudad y dirección
BUSINESS_CITY=Riohacha
BUSINESS_ADDRESS=Calle 15 #5-45, Centro

# Zona horaria (importante para horarios y reportes)
BUSINESS_TIMEZONE=America/Bogota

# -----------------------------------------------------------------------------
# 📞 CONTACTO Y REDES SOCIALES
# -----------------------------------------------------------------------------

BUSINESS_PHONE=+573001234567
BUSINESS_WHATSAPP=+573001234567
BUSINESS_EMAIL=contacto@mundohelados.com
BUSINESS_WEBSITE=https://mundohelados.com

# Redes sociales (sin @)
BUSINESS_INSTAGRAM=mundohelados
BUSINESS_FACEBOOK=mundohelados
BUSINESS_TIKTOK=

# -----------------------------------------------------------------------------
# 🕐 HORARIOS DE ATENCIÓN
# -----------------------------------------------------------------------------

# Horarios normales (Lunes a Viernes)
BUSINESS_HOURS_WEEKDAY_OPEN=09:00
BUSINESS_HOURS_WEEKDAY_CLOSE=20:00

# Horarios fines de semana (Sábado y Domingo)
BUSINESS_HOURS_WEEKEND_OPEN=10:00
BUSINESS_HOURS_WEEKEND_CLOSE=21:00

# Días cerrados (separados por coma)
# Ejemplo: monday,tuesday o dejar vacío si abre todos los días
BUSINESS_CLOSED_DAYS=

# -----------------------------------------------------------------------------
# 🏷️ NOMENCLATURA DE PRODUCTOS (¡CRÍTICO!)
# -----------------------------------------------------------------------------
# Define cómo se llaman los elementos en tu negocio

# Tipo de producto principal (singular/plural)
# Heladería: helado/helados
# Pizzería: pizza/pizzas
# Panadería: pan/panes
PRODUCT_TYPE_SINGULAR=helado
PRODUCT_TYPE_PLURAL=helados

# Item primario (ingrediente principal personalizable)
# Heladería: sabor/sabores
# Pizzería: ingrediente/ingredientes
# Panadería: tipo/tipos
# Restaurante: proteína/proteínas
ITEM_PRIMARY_SINGULAR=sabor
ITEM_PRIMARY_PLURAL=sabores
ITEM_PRIMARY_LABEL=Sabores                    # Para UI
ITEM_PRIMARY_LABEL_SINGULAR=Sabor             # Para UI

# Item secundario (extras personalizables)
# Heladería: topping/toppings
# Pizzería: extra/extras
# Panadería: relleno/rellenos
# Restaurante: acompañamiento/acompañamientos
ITEM_SECONDARY_SINGULAR=topping
ITEM_SECONDARY_PLURAL=toppings
ITEM_SECONDARY_LABEL=Toppings                 # Para UI
ITEM_SECONDARY_LABEL_SINGULAR=Topping         # Para UI

# -----------------------------------------------------------------------------
# 🗄️ CAMPOS DE BASE DE DATOS (Google Sheets / Backend)
# -----------------------------------------------------------------------------
# IMPORTANTE: Estos nombres deben coincidir EXACTAMENTE con tu hoja de cálculo

# Campos principales de producto
DB_FIELD_PRODUCT_NAME=NombreProducto
DB_FIELD_PRODUCT_CODE=CodigoProducto
DB_FIELD_PRODUCT_PRICE=Precio_Venta
DB_FIELD_PRODUCT_CATEGORY=Categoria
DB_FIELD_PRODUCT_IMAGE=Imagen_URL

# Campos de personalización
DB_FIELD_ITEM_PRIMARY_COUNT=Numero_de_Sabores      # Cuántos sabores permite
DB_FIELD_ITEM_SECONDARY_COUNT=Numero_de_Toppings   # Cuántos toppings permite

# Hoja de inventario (nombres en Google Sheets)
SHEET_NAME_PRODUCTS=Productos
SHEET_NAME_FLAVORS=Sabores
SHEET_NAME_TOPPINGS=Toppings
SHEET_NAME_ORDERS=Entregas

# -----------------------------------------------------------------------------
# 🔍 KEYWORDS DE BÚSQUEDA Y DETECCIÓN
# -----------------------------------------------------------------------------
# Palabras clave para detectar intención de compra y buscar productos

# Keywords de productos (separadas por coma, SIN espacios)
# Heladería: caja,copa,litro,paleta,volcan,brownie,helado,topping
# Pizzería: pizza,familiar,mediana,personal,combo,bebida
# Panadería: pan,torta,pastel,galleta,croissant,integral
PRODUCT_KEYWORDS=caja,copa,litro,paleta,volcan,brownie,helado,topping

# Queries de precarga (para cargar catálogo al inicio, separadas por coma)
# El bot hace búsquedas con estos términos para llenar el catálogo
PRELOAD_SEARCH_QUERIES=Litros de Helado,Cajas de Helado,Copas,Paletas

# Variantes ortográficas comunes (para fuzzy matching)
# Ejemplo heladería: heladeria,eladeria,elado,elados
# Ejemplo pizzería: piza,pissa,pitsa
PRODUCT_VARIANTS=heladeria,eladeria,elado,elados,sabor,sabores,topin,topping

# -----------------------------------------------------------------------------
# 💬 MENSAJES Y PLANTILLAS DE TEXTO
# -----------------------------------------------------------------------------
# Puedes usar placeholders: {businessName}, {productType}, {itemPrimary}, etc.

# Saludo principal
MESSAGE_GREETING=¿Cómo estás? Somos {businessName} en {city} 🍦

# Mensaje de bienvenida (primer contacto)
MESSAGE_WELCOME=¡Bienvenido a {businessName}! 🍨\n\nEstoy aquí para ayudarte a hacer tu pedido de {productTypePlural} deliciosos.\n\n¿Qué te gustaría ordenar hoy?

# Menú principal
MESSAGE_MAIN_MENU=🍨 *¡Bienvenido a {businessName}!* 🍨\n\n*¿Qué deseas hacer hoy?*\n\n*1)* 🛒 Hacer un pedido\n*2)* 📦 Pedidos por encargo\n*3)* ℹ️ Información y contacto\n*4)* 🆘 Ayuda

# Mensaje de pedido por encargo
MESSAGE_CUSTOM_ORDER_START=¡Claro! Con gusto te ayudamos con tu pedido por encargo. 😊\n\nPor favor, describe con detalle el pedido que necesitas:\n\n_Ejemplo: 50 {productTypePlural} de vainilla para un evento, 20 mini{productTypePlural} para una fiesta, etc._

# Mensaje de selección de items
MESSAGE_SELECT_PRIMARY_ITEMS=Por favor, selecciona {itemPrimaryLabel} (S1, S2, etc.)
MESSAGE_SELECT_SECONDARY_ITEMS=Por favor, selecciona {itemSecondaryLabel} (T1, T2, etc.)

# Error de selección
MESSAGE_SELECTION_ERROR=❌ No entendí tu respuesta. Por favor, selecciona {itemPrimaryPlural} (S1), {itemSecondaryPlural} (T1) o indica la cantidad.

# Confirmación de pedido
MESSAGE_ORDER_CONFIRMATION=✅ *¡Perfecto!* Tu pedido ha sido confirmado.\n\n*Resumen:*\n{orderSummary}\n\n*Total: {total}*\n\nTe contactaremos pronto para coordinar la entrega. ¡Gracias por tu compra! 🎉

# Mensaje fuera de horario
MESSAGE_OUT_OF_HOURS=🕐 Actualmente estamos fuera de horario.\n\n*Horarios de atención:*\nLun-Vie: {weekdayHours}\nSáb-Dom: {weekendHours}\n\nDeja tu pedido y te contactaremos en cuanto abramos. 😊

# -----------------------------------------------------------------------------
# 🚚 CONFIGURACIÓN DE ENTREGA Y CHECKOUT
# -----------------------------------------------------------------------------

# Domicilio
DELIVERY_ENABLED=true
DELIVERY_FEE=3000
DELIVERY_MIN_ORDER=10000
DELIVERY_FREE_ABOVE=50000

# Métodos de pago aceptados (separados por coma)
PAYMENT_METHODS=Efectivo,Nequi,Daviplata,Transferencia

# Moneda
CURRENCY=COP
CURRENCY_SYMBOL=$

# -----------------------------------------------------------------------------
# 🤖 CONFIGURACIÓN DEL BOT Y IA
# -----------------------------------------------------------------------------

# Nombre del asistente virtual
BOT_ASSISTANT_NAME=MIA

# Prompt del sistema para IA (opcional, usa plantilla por defecto si está vacío)
BOT_AI_SYSTEM_PROMPT=Eres un asistente virtual amigable de {businessName}. Tu objetivo es ayudar a los clientes a hacer pedidos de {productTypePlural} de manera rápida y eficiente.

# Habilitar asistente IA
BOT_AI_ENABLED=true
BOT_AI_MODEL=gpt-4
BOT_AI_MAX_TOKENS=500

# Timeout de sesión (minutos)
BOT_SESSION_TIMEOUT=30

# -----------------------------------------------------------------------------
# 🎨 PERSONALIZACIÓN UI
# -----------------------------------------------------------------------------

# Emoji principal del negocio
UI_EMOJI_MAIN=🍦

# Emojis secundarios
UI_EMOJI_CART=🛒
UI_EMOJI_DELIVERY=🚚
UI_EMOJI_PAYMENT=💰
UI_EMOJI_SUCCESS=✅
UI_EMOJI_ERROR=❌
UI_EMOJI_INFO=ℹ️

# Color del tema (para futuras integraciones web)
UI_COLOR_PRIMARY=#FF6B9D
UI_COLOR_SECONDARY=#4ECDC4

# -----------------------------------------------------------------------------
# 🔗 BACKEND Y API (Django)
# -----------------------------------------------------------------------------

# URL base del backend
API_BASE_URL=http://localhost:8000

# Endpoints (rutas relativas a API_BASE_URL)
API_ENDPOINT_SEARCH_PRODUCT=/buscar_producto_por_nombre/
API_ENDPOINT_CREATE_ORDER=/crear_pedido/
API_ENDPOINT_GET_FLAVORS=/sabores/
API_ENDPOINT_GET_TOPPINGS=/toppings/

# -----------------------------------------------------------------------------
# 📊 GOOGLE SHEETS (Backend Python)
# -----------------------------------------------------------------------------

# ID de la hoja de cálculo de Google Sheets
GOOGLE_SHEET_ID=your-google-sheet-id-here

# Rango de celdas para cada hoja
SHEET_RANGE_PRODUCTS=Productos!A:Z
SHEET_RANGE_FLAVORS=Sabores!A:Z
SHEET_RANGE_TOPPINGS=Toppings!A:Z
SHEET_RANGE_ORDERS=Entregas!A:Z

# -----------------------------------------------------------------------------
# 🔐 SEGURIDAD Y AUTENTICACIÓN
# -----------------------------------------------------------------------------

# Token del bot de WhatsApp
WHATSAPP_TOKEN=your-whatsapp-token-here

# Admin JID (para comandos /admin)
ADMIN_JID=573001234567@s.whatsapp.net

# Webhook secret (opcional)
WEBHOOK_SECRET=your-webhook-secret-here

# -----------------------------------------------------------------------------
# 🐛 DEBUG Y LOGS
# -----------------------------------------------------------------------------

# Nivel de log (debug | info | warn | error)
LOG_LEVEL=info

# Habilitar logs detallados
DEBUG_MODE=false

# Guardar logs en archivo
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/bot.log

# -----------------------------------------------------------------------------
# 🌐 CONFIGURACIÓN DE NEGOCIO (Referencia al archivo de config)
# -----------------------------------------------------------------------------

# Si usas sistema de configuración por archivos (config/businesses/)
# Especifica el nombre del archivo de configuración a cargar
# Ejemplo: heladeria1, pizzeria1, panaderia1
# Si está vacío, usa configuración por ENV únicamente
BUSINESS_CONFIG=heladeria1

# -----------------------------------------------------------------------------
# 🧪 AMBIENTE
# -----------------------------------------------------------------------------

# Ambiente de ejecución (development | production)
NODE_ENV=development

# Puerto del servidor (si aplica)
PORT=3000

# =============================================================================
# 📝 NOTAS IMPORTANTES
# =============================================================================
# 
# 1. NOMENCLATURA: Los valores de ITEM_PRIMARY y ITEM_SECONDARY son críticos.
#    Deben coincidir con los nombres de las hojas de Google Sheets.
#
# 2. CAMPOS DE BD: Los nombres deben ser EXACTOS a las columnas de tu hoja.
#    Si tienes "Nombre" en lugar de "NombreProducto", cambia DB_FIELD_PRODUCT_NAME.
#
# 3. KEYWORDS: Añade TODAS las palabras que tus clientes usan para buscar.
#    Más keywords = mejor detección de intención de compra.
#
# 4. MENSAJES: Usa placeholders para texto dinámico:
#    - {businessName}          → BUSINESS_NAME
#    - {city}                  → BUSINESS_CITY
#    - {productType}           → PRODUCT_TYPE_SINGULAR
#    - {productTypePlural}     → PRODUCT_TYPE_PLURAL
#    - {itemPrimary}           → ITEM_PRIMARY_SINGULAR
#    - {itemPrimaryPlural}     → ITEM_PRIMARY_PLURAL
#    - {itemSecondary}         → ITEM_SECONDARY_SINGULAR
#    - {itemSecondaryPlural}   → ITEM_SECONDARY_PLURAL
#
# 5. GOOGLE SHEETS: Asegúrate de tener los permisos correctos configurados.
#
# 6. TESTING: Prueba cambiar BUSINESS_TYPE y todos los *_SINGULAR/*_PLURAL
#    para validar que el bot se adapta correctamente.
#
# =============================================================================
