# =============================================================================
# 🍕 PIZZERÍA EJEMPLO - CONFIGURACIÓN
# =============================================================================
# Configuración de ejemplo para una pizzería
# Demuestra cómo adaptar el bot genérico a otro tipo de negocio
# =============================================================================

# -----------------------------------------------------------------------------
# 📌 INFORMACIÓN DEL NEGOCIO
# -----------------------------------------------------------------------------

BUSINESS_TYPE=pizzeria
BUSINESS_NAME=Pizzería Don Giovanni
BUSINESS_SHORT_NAME=Don Giovanni
BUSINESS_ID=DON_GIOVANNI_BOGOTA
BUSINESS_CITY=Bogotá
BUSINESS_ADDRESS=Calle 72 #10-20, Chapinero
BUSINESS_TIMEZONE=America/Bogota

# -----------------------------------------------------------------------------
# 📞 CONTACTO Y REDES SOCIALES
# -----------------------------------------------------------------------------

BUSINESS_PHONE=+573101234567
BUSINESS_WHATSAPP=+573101234567
BUSINESS_EMAIL=pedidos@dongiovanni.com
BUSINESS_WEBSITE=https://dongiovanni.com

BUSINESS_INSTAGRAM=dongiovannipizza
BUSINESS_FACEBOOK=dongiovanni
BUSINESS_TIKTOK=dongiovanni

# -----------------------------------------------------------------------------
# 🕐 HORARIOS DE ATENCIÓN
# -----------------------------------------------------------------------------

BUSINESS_HOURS_WEEKDAY_OPEN=11:00
BUSINESS_HOURS_WEEKDAY_CLOSE=22:00
BUSINESS_HOURS_WEEKEND_OPEN=12:00
BUSINESS_HOURS_WEEKEND_CLOSE=23:00
BUSINESS_CLOSED_DAYS=

# -----------------------------------------------------------------------------
# 🏷️ NOMENCLATURA DE PRODUCTOS
# -----------------------------------------------------------------------------
# ⚠️ NOTA: Aquí está la magia del sistema genérico
# Para pizzería, los "sabores" son "ingredientes" y los "toppings" son "extras"

PRODUCT_TYPE_SINGULAR=pizza
PRODUCT_TYPE_PLURAL=pizzas

# En pizzería, el item primario son los INGREDIENTES
ITEM_PRIMARY_SINGULAR=ingrediente
ITEM_PRIMARY_PLURAL=ingredientes
ITEM_PRIMARY_LABEL=Ingredientes
ITEM_PRIMARY_LABEL_SINGULAR=Ingrediente

# En pizzería, el item secundario son los EXTRAS (queso extra, orégano, ají)
ITEM_SECONDARY_SINGULAR=extra
ITEM_SECONDARY_PLURAL=extras
ITEM_SECONDARY_LABEL=Extras
ITEM_SECONDARY_LABEL_SINGULAR=Extra

# -----------------------------------------------------------------------------
# 🗄️ CAMPOS DE BASE DE DATOS
# -----------------------------------------------------------------------------

DB_FIELD_PRODUCT_NAME=NombreProducto
DB_FIELD_PRODUCT_CODE=CodigoProducto
DB_FIELD_PRODUCT_PRICE=Precio_Venta
DB_FIELD_PRODUCT_CATEGORY=Categoria
DB_FIELD_PRODUCT_IMAGE=Imagen_URL

# ⚠️ IMPORTANTE: Tus hojas de Google Sheets deben tener estas columnas
# Para pizzería, "Numero_de_Ingredientes" y "Numero_de_Extras"
DB_FIELD_ITEM_PRIMARY_COUNT=Numero_de_Ingredientes
DB_FIELD_ITEM_SECONDARY_COUNT=Numero_de_Extras

# Nombres de las hojas en Google Sheets
SHEET_NAME_PRODUCTS=Productos
SHEET_NAME_FLAVORS=Ingredientes      # Ojo: técnicamente "flavors" pero se llama "Ingredientes"
SHEET_NAME_TOPPINGS=Extras            # Ojo: técnicamente "toppings" pero se llama "Extras"
SHEET_NAME_ORDERS=Pedidos

# -----------------------------------------------------------------------------
# 🔍 KEYWORDS DE BÚSQUEDA
# -----------------------------------------------------------------------------

# Keywords específicas de pizzería
PRODUCT_KEYWORDS=pizza,familiar,mediana,personal,combo,bebida,lasagna,pasta,calzone
PRELOAD_SEARCH_QUERIES=Pizza Familiar,Pizza Mediana,Pizza Personal,Combos,Bebidas
PRODUCT_VARIANTS=piza,pissa,pitsa,ingrediente,ingredientes,extra,queso,peperoni,pepperoni

# -----------------------------------------------------------------------------
# 💬 MENSAJES
# -----------------------------------------------------------------------------

MESSAGE_GREETING=¿Cómo estás? Somos {businessName} en {city} 🍕

MESSAGE_WELCOME=¡Bienvenido a {businessName}! 🍕\n\nEstoy aquí para ayudarte a pedir tus {productTypePlural} favoritas.\n\n*¿Qué deseas hacer hoy?*\n\n*1)* 🛒 Ver nuestras {productTypePlural}\n*2)* 📦 Pedidos para eventos\n*3)* ℹ️ Información y contacto

MESSAGE_MAIN_MENU=🍕 *¡Bienvenido a {businessName}!* 🍕\n\n*¿Qué deseas hacer hoy?*\n\n*1)* 🛒 Hacer un pedido\n*2)* 📦 Pedidos para eventos (grandes cantidades)\n*3)* ℹ️ Información y contacto\n*4)* 🆘 Ayuda\n\nEscribe el número de tu opción o cuéntame qué necesitas 😊

MESSAGE_CUSTOM_ORDER_START=¡Perfecto! Con gusto te ayudamos con tu pedido para eventos. 🎉\n\nPor favor, describe con detalle tu pedido:\n\n_Ejemplos:_\n• 10 {productTypePlural} familiares para una reunión\n• 20 {productTypePlural} personales para una fiesta\n• Combo de 5 {productTypePlural} con bebidas\n\nEscribe tu pedido y te ayudaré 🍕

MESSAGE_SELECT_PRIMARY_ITEMS=Por favor, selecciona los {itemPrimaryPlural} para tu {productType}:\n\n_Ejemplo: I1, I3, I5_\n\nPuedes elegir hasta {maxItems} {itemPrimaryPlural}.

MESSAGE_SELECT_SECONDARY_ITEMS=¿Quieres agregar {itemSecondaryPlural}?\n\nSelecciona los que quieras:\n_Ejemplo: E1, E2_\n\nO escribe *sin {itemSecondaryPlural}* si no deseas.

MESSAGE_SELECTION_ERROR=❌ No entendí tu respuesta.\n\nPor favor:\n• Selecciona {itemPrimaryPlural} → *I1, I2*\n• Selecciona {itemSecondaryPlural} → *E1, E2*\n• Indica cantidad → *2* o *dos*

MESSAGE_ORDER_CONFIRMATION=✅ *¡Excelente!* Tu pedido ha sido confirmado.\n\n📋 *Resumen:*\n{orderSummary}\n\n💰 *Total: {total}*\n\n📍 *Dirección:* {address}\n🚚 *Domicilio:* {deliveryFee}\n\nTu {productType} llegará caliente y deliciosa. ¡Gracias por tu compra! 🍕

MESSAGE_OUT_OF_HOURS=🕐 Actualmente estamos fuera de horario.\n\n*Horarios de atención:*\n🕒 Lun-Vie: {weekdayHours}\n🕒 Sáb-Dom: {weekendHours}\n\nDeja tu pedido y te contactaremos cuando abramos. ¡Gracias! 😊

# -----------------------------------------------------------------------------
# 🚚 ENTREGA Y CHECKOUT
# -----------------------------------------------------------------------------

DELIVERY_ENABLED=true
DELIVERY_FEE=5000
DELIVERY_MIN_ORDER=15000
DELIVERY_FREE_ABOVE=60000

PAYMENT_METHODS=Efectivo,Nequi,Daviplata,Tarjeta

CURRENCY=COP
CURRENCY_SYMBOL=$

# -----------------------------------------------------------------------------
# 🤖 BOT Y IA
# -----------------------------------------------------------------------------

BOT_ASSISTANT_NAME=GIOVANNI

BOT_AI_SYSTEM_PROMPT=Eres "Giovanni", el asistente virtual de Pizzería Don Giovanni en Bogotá. Tu objetivo es ayudar a los clientes a pedir pizzas de manera rápida y eficiente. Debes ser: 1) Cálido y profesional con toque italiano, 2) Experto en recomendar combinaciones de ingredientes, 3) Claro al explicar tamaños y precios. Usa emojis de pizza 🍕 ocasionalmente.

BOT_AI_ENABLED=true
BOT_AI_MODEL=gpt-4
BOT_AI_MAX_TOKENS=500

BOT_SESSION_TIMEOUT=30

# -----------------------------------------------------------------------------
# 🎨 UI
# -----------------------------------------------------------------------------

UI_EMOJI_MAIN=🍕
UI_EMOJI_CART=🛒
UI_EMOJI_DELIVERY=🏍️
UI_EMOJI_PAYMENT=💰
UI_EMOJI_SUCCESS=✅
UI_EMOJI_ERROR=❌
UI_EMOJI_INFO=ℹ️

UI_COLOR_PRIMARY=#E74C3C
UI_COLOR_SECONDARY=#F39C12

# -----------------------------------------------------------------------------
# 🔗 BACKEND
# -----------------------------------------------------------------------------

API_BASE_URL=http://localhost:8000

API_ENDPOINT_SEARCH_PRODUCT=/buscar_producto_por_nombre/
API_ENDPOINT_CREATE_ORDER=/crear_pedido/
API_ENDPOINT_GET_FLAVORS=/ingredientes/    # Nota: endpoint cambia a "ingredientes"
API_ENDPOINT_GET_TOPPINGS=/extras/          # Nota: endpoint cambia a "extras"

# -----------------------------------------------------------------------------
# 📊 GOOGLE SHEETS
# -----------------------------------------------------------------------------

GOOGLE_SHEET_ID=your-pizzeria-sheet-id-here

SHEET_RANGE_PRODUCTS=Productos!A:Z
SHEET_RANGE_FLAVORS=Ingredientes!A:Z
SHEET_RANGE_TOPPINGS=Extras!A:Z
SHEET_RANGE_ORDERS=Pedidos!A:Z

# -----------------------------------------------------------------------------
# 🔐 SEGURIDAD
# -----------------------------------------------------------------------------

WHATSAPP_TOKEN=your-token-here
ADMIN_JID=573101234567@s.whatsapp.net
WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 🐛 DEBUG
# -----------------------------------------------------------------------------

LOG_LEVEL=info
DEBUG_MODE=false
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/bot.log

# -----------------------------------------------------------------------------
# 🌐 CONFIGURACIÓN DE NEGOCIO
# -----------------------------------------------------------------------------

# Si tienes archivo específico en config/businesses/pizzeria1.config.js
BUSINESS_CONFIG=

# -----------------------------------------------------------------------------
# 🧪 AMBIENTE
# -----------------------------------------------------------------------------

NODE_ENV=production
PORT=3000

# =============================================================================
# 📝 NOTAS PARA PIZZERÍA
# =============================================================================
#
# 1. GOOGLE SHEETS: Tu hoja debe tener:
#    - Columna "Numero_de_Ingredientes" (ej: 3 ingredientes para pizza familiar)
#    - Columna "Numero_de_Extras" (ej: 2 extras permitidos)
#
# 2. HOJAS REQUERIDAS:
#    - "Productos" → Pizzas (Familiar, Mediana, Personal, etc.)
#    - "Ingredientes" → Pepperoni, Champiñones, Cebolla, etc.
#    - "Extras" → Queso extra, Orégano, Ají, etc.
#    - "Pedidos" → Donde se guardan los pedidos
#
# 3. MENSAJES: El bot automáticamente usará:
#    - "ingredientes" en lugar de "sabores"
#    - "extras" en lugar de "toppings"
#    - "pizza/pizzas" en lugar de "helado/helados"
#
# 4. FLUJO DE PEDIDO:
#    Cliente: "Quiero una pizza familiar"
#    Bot: "Por favor, selecciona los ingredientes para tu pizza: I1, I2..."
#    Cliente: "I1, I3, I5"
#    Bot: "¿Quieres agregar extras? E1, E2... o 'sin extras'"
#
# =============================================================================
