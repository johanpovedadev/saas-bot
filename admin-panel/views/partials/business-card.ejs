<section class="card" data-key="<%= business.key %>">
  <header class="card-header">
    <h2><%= business.name %></h2>
    <span class="status-badge" data-status-badge>cargando…</span>
  </header>

  <div class="card-row" data-info>
    <span>PID: <span data-pid>—</span></span>
    <span>Número conectado: <span data-owner>—</span></span>
  </div>

  <div class="card-actions">
    <button type="button" class="btn btn-start" data-action="start">▶️ Prender</button>
    <button type="button" class="btn btn-stop" data-action="stop">⏹️ Apagar</button>
  </div>

  <% if (business.channel === 'whatsapp') { %>
  <div class="card-section qr-section" data-qr-section style="display:none">
    <h3>Escanear para conectar</h3>
    <img class="qr-image" data-qr-image alt="Código QR">
    <p class="qr-hint">Escanéalo con el WhatsApp del número de este negocio (Ajustes → Dispositivos vinculados → Vincular un dispositivo). Se renueva solo cada minuto.</p>
  </div>
  <% } %>

  <% if (business.channel === 'whatsapp') { %>
  <div class="card-section">
    <h3>Silenciar un número</h3>
    <div class="inline-form">
      <input type="text" placeholder="573XXXXXXXXX" data-mute-input>
      <button type="button" class="btn" data-action="mute">Silenciar</button>
      <button type="button" class="btn" data-action="unmute">Desilenciar</button>
    </div>
    <ul class="muted-list" data-muted-list></ul>
  </div>

  <div class="card-section">
    <h3>Esperando atención humana</h3>
    <ul class="muted-list waiting-human-list" data-waiting-human-list></ul>
    <p class="qr-hint">Reactivar acá NO le avisa nada al cliente — sigue la conversación como si nunca se hubiera cortado.</p>
  </div>
  <% } else { %>
  <div class="card-section muted-note">Silenciar por número no disponible para Telegram todavía.</div>
  <% } %>

  <div class="card-section">
    <h3>Conversaciones recientes</h3>
    <div class="log-viewer" data-log-viewer>—</div>
  </div>

  <% if (business.key === 'pilates_clientas') { %>
  <div class="card-section">
    <h3>Clases agendadas (próximos 7 días)</h3>
    <div class="pilates-sessions" data-pilates-sessions>—</div>
  </div>

  <div class="card-section">
    <h3>Días de clase</h3>
    <ul class="schedule-list" data-schedule-days>—</ul>
    <div class="inline-form">
      <select data-schedule-day-key>
        <option value="lunes">Lunes</option>
        <option value="martes">Martes</option>
        <option value="miercoles">Miércoles</option>
        <option value="jueves">Jueves</option>
        <option value="viernes">Viernes</option>
        <option value="sabado">Sábado</option>
        <option value="domingo">Domingo</option>
      </select>
      <button type="button" class="btn" data-action="guardar-schedule-day">Agregar/activar</button>
    </div>
    <p class="qr-hint">El nombre a mostrar se toma del día elegido. Un día ya activo no se duplica.</p>
  </div>

  <div class="card-section">
    <h3>Horarios y cupo</h3>
    <ul class="schedule-list" data-schedule-slots>—</ul>
    <div class="inline-form">
      <input type="text" placeholder="Inicio (05:00)" data-schedule-slot-start class="input-narrow">
      <input type="text" placeholder="Fin (06:00)" data-schedule-slot-end class="input-narrow">
      <input type="number" min="1" placeholder="Cupo" data-schedule-slot-capacity class="input-narrow">
      <button type="button" class="btn" data-action="guardar-schedule-slot">Agregar/editar</button>
    </div>
    <p class="qr-hint">Mismo horario de inicio = edita el existente (fin y cupo). Aplica en el siguiente mensaje de cualquier clienta, sin reiniciar el bot.</p>
  </div>
  <% } %>

  <% if (business.leadsAdapter === 'pilates_creditos') { %>
  <div class="card-section">
    <h3>Cargar clienta</h3>
    <div class="inline-form">
      <input type="text" placeholder="Teléfono (573XXXXXXXXX)" data-credito-telefono>
      <input type="text" placeholder="Nombre" data-credito-nombre>
      <input type="number" min="0" placeholder="Clases al mes" data-credito-clases class="input-narrow">
      <button type="button" class="btn" data-action="guardar-credito">Guardar</button>
    </div>
    <p class="qr-hint">Se resetea solo cada mes: lo que ya tomó y lo que le queda siempre se calculan contra el mes en curso.</p>
  </div>
  <% } %>

  <% if (business.key === 'finance') { %>
  <div class="card-section">
    <h3>Usuarios activos</h3>
    <div class="card-row" data-finance-stats>
      <span>Hoy: <span data-finance-today>—</span></span>
      <span>Esta semana: <span data-finance-week>—</span></span>
      <span>Este mes: <span data-finance-month>—</span></span>
    </div>
  </div>
  <% } %>

  <div class="card-section">
    <h3><%= business.leadsLabel || 'Leads' %></h3>
    <div class="leads-viewer" data-leads-viewer>—</div>
  </div>
</section>
