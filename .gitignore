# Archivo .gitignore para Node.js y Python/Django

# Node.js
/node_modules
.env
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python / Django
__pycache__/
*.pyc
*.pyo
*.pyd
db.sqlite3
/media/
/static/

# Archivos de Sesión de Baileys
/auth_info_baileys.json
/creds.json
bot-wasap/auth_info_baileys/

# Archivos del Sistema Operativo
.DS_Store
Thumbs.db

# Sensitive keys and service account files
service_account.json
bot-wasap/service_account.json
replace-secrets.txt
bot-wasap/.env
bot-wasap/.env.local

# Additional sensitive artifacts
service_account_decoded.json
repo-backup.bundle
sensitive-backup*.zip
service_account.json.bak.backup
filter-repo-output.txt
gitleaks-report.json
replace-secrets.txt

# Ignore tmp logs created by local tests
/tmp/
tmp/

# Ensure Baileys session folder is ignored at repo root and inside bot-wasap
auth_info_baileys/
bot-wasap/auth_info_baileys/

# Logs and local artifacts
logs/
bot-wasap/conversations.log
user_errors.log
