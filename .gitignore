# Archivo .gitignore para Node.js y Python/Django

# Node.js
/node_modules
.env
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python / Django
__pycache__/
*.pyc
*.pyo
*.pyd
db.sqlite3
/media/
/static/

# Archivos del Sistema Operativo
.DS_Store
Thumbs.db

# Sensitive keys and service account files
service_account.json
bot-wasap/service_account.json
replace-secrets.txt
bot-wasap/.env
bot-wasap/.env.local
# Tenant-specific env files contain secrets - NUNCA commitear
.env.pescaderia
.env.*
!.env.example
!.env.template

# Additional sensitive artifacts
service_account_decoded.json
repo-backup.bundle
sensitive-backup*.zip
service_account.json.bak.backup
filter-repo-output.txt
gitleaks-report.json
replace-secrets.txt
backoups.json
bot-wasap/backoups.json
service_account_decoded.json
bot-wasap/service_account_decoded.json

# Ignore tmp logs created by local tests
/tmp/
tmp/

# Virtual environment
venv/
.virtualenvs/

# WhatsApp Web JS auth (legacy - ISSUE 44: migrado a auth/)
.wwebjs_auth/
bot-wasap/.wwebjs_auth/

# ISSUE 44: Sesiones independientes por negocio
bot-wasap/auth/

# Logs and local artifacts
logs/
bot-wasap/conversations.log
user_errors.log

# Generated by launch-tenants.js
run_tenants.bat

# IDE
.vscode/
.idea/
*.swp
*.swo

# WhatsApp Web JS cache + session QR (no commitear)
.wwebjs_cache/
bot-wasap/.wwebjs_cache/
bot-wasap/qr_code.png
bot-wasap/assets/*/qr_code.png

# Artefactos accidentales por rutas rotas de salida
UsersAdministradorDocumentsempanadas_prods.json
ersAdministradorDocumentsMundoherladoscobot-wasap
nul
